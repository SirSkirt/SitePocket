{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only SitePocket's local management UI gets native API permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPLOCALDATA/mobile-imports/**"
        },
        {
          "path": "$APPLOCALDATA/mobile-imports"
        }
      ]
    }
  ]
}
